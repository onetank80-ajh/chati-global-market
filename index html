<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0b1020"><title>차티 글로벌 마켓 브리핑 v1.0.1</title>
<style>:root{color-scheme:dark;font-family:system-ui,-apple-system,'Noto Sans KR',sans-serif;background:#0b1020;color:#f2f5ff}*{box-sizing:border-box}body{margin:0;padding:0 16px 48px}main{max-width:680px;margin:auto}.head{padding:30px 0 20px}.eyebrow{color:#9ba9d5;font-size:12px;font-weight:800;letter-spacing:1.4px}h1{font-size:26px;letter-spacing:-1px;margin:8px 0}.muted{color:#9aa6c2;font-size:13px}.bar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:16px 0 20px;flex-wrap:wrap}button{background:#3d66ec;color:white;border:0;border-radius:12px;padding:11px 16px;font-weight:750}button:disabled{opacity:.6}.pill{border:1px solid #303d60;color:#b9c6e9;border-radius:30px;padding:7px 10px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card,.panel{background:#161f35;border:1px solid #293655;border-radius:18px;padding:17px}.card .label{font-size:13px;color:#afbddb}.number{font-size:clamp(19px,5vw,26px);font-weight:800;margin:10px 0 4px;font-variant-numeric:tabular-nums}.delta{font-size:15px;font-weight:800}.up{color:#ff777f}.down{color:#67a9ff}.date,.tag{font-size:11px;color:#9ba9d5;margin-top:8px}.panel{margin-top:15px}h2{font-size:17px;margin:0 0 12px}.insight{margin:10px 0;padding-left:13px;border-left:3px solid #4c6cbd;font-size:14px;line-height:1.6}.notice{background:#20243a;border-radius:12px;padding:12px;color:#b9c5de;font-size:12px;line-height:1.6;margin-top:15px}.error{color:#ff999d}.newsitem{padding:13px 0;border-top:1px solid #303d60}.newsitem a{color:#dce6ff;text-decoration:none;font-weight:650;line-height:1.5;overflow-wrap:anywhere}.footer{padding-top:18px;font-size:12px;color:#8291af}.wide{grid-column:span 2}@media(max-width:350px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}}</style></head>
<body><main><header class="head"><div class="eyebrow">CHATI · GLOBAL MARKET</div><h1>차티 글로벌 마켓 브리핑</h1><div class="muted">미국 증시 지표 · 주요 뉴스 · 규칙 기반 참고 분석 · v1.0.1</div></header><div class="bar"><span class="pill" id="status">데이터 확인 중</span><button id="refresh" type="button">↻ 새로고침</button></div><div class="grid" id="cards"><div class="card wide muted">시장 데이터 확인 중…</div></div><section class="panel"><h2>🇰🇷 한국 증시 참고 시나리오</h2><div id="analysis" class="muted">데이터 확인 중…</div></section><section class="panel"><h2>🧭 뉴스 신선도·업종 참고 분석 v0.5</h2><p class="muted">기사 제목 기반 자동 분류 · AI 번역이나 주가 예측 아님</p><div id="briefing">분석 데이터 확인 중…</div><div id="briefingUpdated" class="date"></div></section><section class="panel"><h2>📰 주요 시장 뉴스</h2><div id="news">뉴스 확인 중…</div><div id="newsUpdated" class="date"></div></section><section class="panel"><h2>📊 통합 시장 브리핑 v1.0.1</h2><p class="muted">중복 제거 · 시장 관련성 · 업종별 참고 시나리오 (규칙 기반)</p><div id="intel">통합 분석 확인 중…</div><div id="intelUpdated" class="date"></div></section><div class="notice">⚠️ 최근 일별 종가 스냅샷이며 실시간 시세가 아닙니다. 기사 본문은 검증되지 않았고 분석은 매매 신호가 아닙니다. 데이터 제공처에 따라 지연·누락될 수 있습니다.</div><div class="footer" id="updated">데이터 확인 중…</div></main>
<script>
'use strict';
const $=id=>document.getElementById(id);
const LABELS=[['nasdaq','나스닥 종합'],['sp500','S&P 500'],['dow','다우존스'],['sox','필라델피아 반도체'],['usdkrw','원/달러 환율']];
const CATEGORY={us_market:'미국 증시',semiconductor:'반도체',korea:'한국 증시'};
function fmt(n,d=2){return typeof n==='number'&&Number.isFinite(n)?n.toLocaleString('ko-KR',{minimumFractionDigits:d,maximumFractionDigits:d}):'—'}
function dateText(s){const d=new Date(s||'');return Number.isNaN(d.getTime())?'확인 불가':d.toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})+' KST'}
function line(box,text,cls='insight'){const p=document.createElement('div');p.className=cls;p.textContent=text;box.append(p);return p}
function linkItem(box,title,url,meta){const el=document.createElement('div');el.className='newsitem';line(el,meta,'tag');if(typeof url==='string'&&/^https:\/\//.test(url)){const a=document.createElement('a');a.href=url;a.target='_blank';a.rel='noopener noreferrer';a.textContent=title||'제목 없음';el.append(a)}else line(el,title||'제목 없음');box.append(el)}
async function getJSON(file){const url=new URL('data/'+file,location.href);url.searchParams.set('t',Date.now());let r;try{r=await fetch(url,{cache:'no-store'})}catch(e){throw Error(file+' 네트워크 오류: '+e.message)}if(!r.ok)throw Error(file+' HTTP '+r.status);try{return await r.json()}catch(e){throw Error(file+' JSON 해석 오류: '+e.message)}}
function renderMarket(d){if(!d||!d.markets)throw Error('market.json에 markets 항목이 없습니다');const cards=$('cards');cards.replaceChildren();let good=0;for(const [key,label] of LABELS){const m=d.markets[key]||{};const c=document.createElement('article');c.className='card';line(c,label,'label');const ok=m.status==='ok'&&Number.isFinite(m.close)&&Number.isFinite(m.change_percent);if(ok)good++;line(c,ok?fmt(m.close)+(key==='usdkrw'?'원':''):'수집 불가','number');const delta=line(c,ok?(m.change_percent>0?'+':'')+fmt(m.change_percent)+'% ('+(m.change>0?'+':'')+fmt(m.change)+')':'다음 갱신 대기','delta');if(ok)delta.classList.add(m.change_percent>0?'up':m.change_percent<0?'down':'flat');line(c,ok?'기준일 '+(m.market_date||'확인 불가'):'','date');cards.append(c)}const a=$('analysis');a.replaceChildren();const sp=d.markets.sp500||{},sox=d.markets.sox||{},fx=d.markets.usdkrw||{};if(sp.status==='ok')line(a,sp.change_percent>=0?'S&P 500 상승: 미국 대형주 투자심리에 우호적인 참고 신호입니다.':'S&P 500 하락: 위험 선호 약화 가능성을 점검하세요.');if(sox.status==='ok')line(a,sox.change_percent>=0?'반도체지수 상승: 국내 반도체 관련주에 우호적일 수 있습니다.':'반도체지수 하락: 국내 반도체 관련주 변동성에 주의하세요.');if(fx.status==='ok')line(a,fx.change_percent<0?'원/달러 하락: 원화 강세 방향입니다.':fx.change_percent>0?'원/달러 상승: 원화 약세 방향입니다.':'원/달러 변동이 제한적입니다.');if(!a.childElementCount)line(a,'참고할 지표가 없습니다.');$('updated').textContent='시장 데이터 생성: '+dateText(d.generated_at_kst||d.generated_at_utc)+' · 수집 성공 '+good+'/5';$('status').textContent=good===5?'● 데이터 연결 정상':good?'● 일부 데이터 수집':'● 수집된 지표 없음'}
function renderNews(d){if(!Array.isArray(d.items))throw Error('news.json items 형식 오류');const b=$('news');b.replaceChildren();for(const n of d.items.slice(0,15))linkItem(b,n.title,n.url,(CATEGORY[n.category]||'시장 뉴스')+' · '+(n.source||'출처 미상')+' · '+dateText(n.published_at_utc));if(!b.childElementCount)line(b,'표시할 뉴스가 없습니다.');$('newsUpdated').textContent='뉴스 수집: '+dateText(d.generated_at_kst||d.generated_at_utc)}
function renderBriefing(d){if(!Array.isArray(d.headlines))throw Error('briefing.json headlines 형식 오류');const b=$('briefing');b.replaceChildren();line(b,'지수 참고: '+(d.market_signals||[]).map(x=>x.indicator+' '+x.reference_direction).join(' · '));for(const n of d.headlines.slice(0,8))linkItem(b,n.title,n.url,(n.sectors||[]).join(', ')+' · 제목 표현: '+(n.headline_tone||'불명')+' · 신선도 '+n.freshness_score+'/100 · '+n.age_hours+'시간 전');if(!d.headlines.length)line(b,'최근 48시간 해당 뉴스가 없습니다.');$('briefingUpdated').textContent='규칙 기반 분석 생성: '+dateText(d.generated_at_kst||d.generated_at_utc)}
function renderIntel(d){if(!Array.isArray(d.sectors)||!Array.isArray(d.top_headlines))throw Error('intelligence.json sectors/top_headlines 형식 오류');const b=$('intel');b.replaceChildren();line(b,'최근 48시간 뉴스 '+(d.headline_count_before??'—')+'건 중 정리 후 '+(d.headline_count_after??'—')+'건');for(const s of d.sectors)line(b,(s.name||'업종')+' · '+(s.view||'')+' — '+(s.basis||'')+(s.related_stocks?.length?' · 관련 종목: '+s.related_stocks.join(', '):''));const h=document.createElement('h2');h.textContent='주요 관련 뉴스';h.style.marginTop='20px';b.append(h);for(const n of d.top_headlines.slice(0,8))linkItem(b,n.title,n.url,'관련성 '+n.relevance_score+'/100 · '+(n.tags||[]).join(' · ')+' · '+(n.source||'')+' · '+n.age_hours+'시간 전');$('intelUpdated').textContent='통합 분석 생성: '+dateText(d.generated_at_kst||d.generated_at_utc)+' · 기사 본문 미검증'}
let busy=false;async function loadAll(){if(busy)return;busy=true;$('refresh').disabled=true;$('status').textContent='● 데이터 확인 중';const tasks=[['market.json',renderMarket,'cards'],['news.json',renderNews,'news'],['briefing.json',renderBriefing,'briefing'],['intelligence.json',renderIntel,'intel']];const results=await Promise.allSettled(tasks.map(async ([file,render])=>render(await getJSON(file))));let failures=0;results.forEach((r,i)=>{if(r.status==='rejected'){failures++;const [file,,id]=tasks[i];const b=$(id);b.replaceChildren();line(b,'⚠️ '+file+' 연결/표시 오류: '+(r.reason?.message||String(r.reason)),'error');if(file==='market.json'){$('analysis').textContent='시장 데이터를 읽지 못했습니다.';$('updated').textContent='시장 데이터 연결 실패'}}});if(failures)$('status').textContent='● '+(4-failures)+'/4 데이터 연결 · '+failures+'개 오류';else $('status').textContent='● 4/4 데이터 연결 정상';$('refresh').disabled=false;busy=false}
$('refresh').addEventListener('click',loadAll);loadAll();
</script></body></html>
